        <name>Query Movies By Category</name>
        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {
 
    var returnObj = {};
 
    var grGenres = new GlideRecord("x_1812797_sharkf_0_genre");
    grGenres.query();
    while(grGenres.next()) {
        returnObj[grGenres.getValue("name")] = [];
        var grMedias = new GlideRecord("x_1812797_sharkf_0_media");
        //grMedias.addEncodedQuery("state=3^integration_state=3^genreLIKE" + grGenres.getValue("sys_id"));
        grMedias.addEncodedQuery("genreLIKE" + grGenres.getValue("sys_id"));
        grMedias.query();
        while(grMedias.next()) {
            returnObj[grGenres.getValue("name")].push({
                "name": grMedias.getValue("title"),
                "average_rating": grMedias.getValue("average_rating")
            });
        }
    }
 
    return returnObj;
 
})(request, response);]]></operation_script>
